@startuml RVC_Domain_Model
title RVC SW Controller Domain Model

skinparam classAttributeIconSize 0
hide methods

class "Automatic Cleaning" as AutomaticCleaning {
  movementStatus
  travelDirection
}

class "Sensor State" as SensorState {
  frontObstacleDetected
  backObstacleDetected
  dustDetected
}

class "Cleaning Policy" as CleaningPolicy {
  normalPowerLevel
  increasedPowerLevel
}

class "Rotation Context" as RotationContext {
  active
  cause
  rotationDirection
  targetSensor
  nextDirection
}

class "Movement Command" as MovementCommand {
  commandType
}

class "Cleaning Command" as CleaningCommand {
  powerLevel
}

enum "Movement Status" as MovementStatus {
  CLEANING
  ROTATING
}

enum "Travel Direction" as TravelDirection {
  FORWARD
  BACKWARD
}

enum "Rotation Direction" as RotationDirection {
  CLOCKWISE
  COUNTER_CLOCKWISE
}

enum "Rotation Cause" as RotationCause {
  DUST
  OBSTACLE
}

enum "Target Sensor" as TargetSensor {
  FRONT
  BACK
}

enum "Movement Command Type" as MovementCommandType {
  MOVE_FORWARD
  MOVE_BACKWARD
  TURN_CLOCKWISE_90
  TURN_COUNTER_CLOCKWISE_90
}

enum "Cleaning Power Level" as CleaningPowerLevel {
  NORMAL
  BOOST
}

AutomaticCleaning "1" --> "1" SensorState : reads
AutomaticCleaning "1" --> "1" CleaningPolicy : uses
AutomaticCleaning "1" --> "0..1" RotationContext : owns
AutomaticCleaning "1" --> "0..*" MovementCommand : issues
AutomaticCleaning "1" --> "0..*" CleaningCommand : issues
AutomaticCleaning "1" --> "1" MovementStatus : has
AutomaticCleaning "1" --> "1" TravelDirection : has

SensorState "1" --> "0..1" RotationContext : triggers

CleaningPolicy "1" --> "1" CleaningPowerLevel : defines

RotationContext "1" --> "1" RotationCause : caused by
RotationContext "1" --> "1" RotationDirection : rotates
RotationContext "1" --> "1" TargetSensor : checks
RotationContext "1" --> "1" TravelDirection : toggles to

MovementCommand "1" --> "1" MovementCommandType : uses
CleaningCommand "1" --> "1" CleaningPowerLevel : uses

@enduml
