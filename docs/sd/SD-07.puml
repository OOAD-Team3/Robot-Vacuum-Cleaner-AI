' SD-07. UC-007 90도 단위 회전 중 센서 재확인
' Related Use Case: UC-007. 90도 단위 회전 중 센서 재확인
' Intent: 회전 절차 중 대상 센서가 계속 막혀 있으면 같은 방향 90도 회전을 반복하고, 열리면 진행 방향 Toggle과 주행 재개를 완료하는 흐름을 표현한다.

@startuml SD_07_UC007_Rotation_Recheck
hide footbox
title SD-07 - UC-007 90도 단위 회전 중 센서 재확인

actor "센서 입력" as Sensor
participant "RVC SW Controller" as Controller
participant "SensorState" as SensorState
participant "AutomaticCleaning" as Cleaning
participant "RotationContext" as RotationContext
participant "CommandResult" as CommandResult
participant "CleaningCommand" as CleaningCommand
participant "MovementCommand" as MovementCommand
actor "청소 장치" as Cleaner
actor "주행 장치" as Drive

Sensor -> Controller: reportTargetObstacleState(targetObstacleDetected)
activate Controller
Controller -> SensorState: updateObstacle(rotationContext.targetSensor, targetObstacleDetected)
Controller -> Cleaning: handleSensorState(SensorState)
activate Cleaning
Cleaning -> RotationContext: targetSensor()
RotationContext --> Cleaning: FRONT or BACK
Cleaning -> SensorState: obstacleDetectedIn(targetSensor)

alt targetObstacleDetected = true
    SensorState --> Cleaning: true
    Cleaning -> RotationContext: rotationDirection()
    RotationContext --> Cleaning: CLOCKWISE or COUNTER_CLOCKWISE
    alt rotationDirection = CLOCKWISE
        Cleaning -> MovementCommand: create(TURN_CLOCKWISE_90)
    else rotationDirection = COUNTER_CLOCKWISE
        Cleaning -> MovementCommand: create(TURN_COUNTER_CLOCKWISE_90)
    end
    Cleaning -> CommandResult: withMovement(turnCommand)
    RotationContext --> Cleaning: keep active
    Cleaning --> Controller: commandResult(turnCommand)
    Controller -> Drive: repeat 90 degree turn
else targetObstacleDetected = false
    SensorState --> Cleaning: false
    Cleaning -> RotationContext: nextDirection()
    RotationContext --> Cleaning: FORWARD or BACKWARD
    Cleaning -> RotationContext: cause()
    alt cause = DUST
        Cleaning -> CleaningCommand: create(NORMAL)
        Cleaning -> CommandResult: withCleaning(normalCommand)
    else cause = OBSTACLE
        note right of Cleaning: 일반 모드 유지
    end
    alt nextDirection = FORWARD
        Cleaning -> MovementCommand: create(MOVE_FORWARD)
    else nextDirection = BACKWARD
        Cleaning -> MovementCommand: create(MOVE_BACKWARD)
    end
    Cleaning -> RotationContext: complete()
    Cleaning -> CommandResult: withMovement(moveCommand)
    Cleaning --> Controller: commandResult
    alt cause = DUST
        Controller -> Cleaner: setCleaningPower(NORMAL)
    end
    alt nextDirection = FORWARD
        Controller -> Drive: moveForward()
    else nextDirection = BACKWARD
        Controller -> Drive: moveBackward()
    end
end

deactivate Cleaning
deactivate Controller
@enduml
