SEND RESET
EXPECT OK RESET

SEND SET_SENSOR_SNAPSHOT FRONT=0 BACK=UNKNOWN DUST=0
EXPECT OK SET_SENSOR_SNAPSHOT

SEND GET_STATE
EXPECT_CONTAINS MOVEMENT=CLEANING
EXPECT_CONTAINS DIRECTION=FORWARD
EXPECT_CONTAINS ROTATION_ACTIVE=0
EXPECT_CONTAINS FRONT=0
EXPECT_CONTAINS BACK=UNKNOWN
EXPECT_CONTAINS DUST=0
