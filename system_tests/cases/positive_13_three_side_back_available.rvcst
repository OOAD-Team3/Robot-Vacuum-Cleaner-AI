SEND RESET
EXPECT OK RESET

SEND SET_SENSOR_SNAPSHOT FRONT=1 BACK=1 DUST=0
EXPECT OK SET_SENSOR_SNAPSHOT

SEND SET_SENSOR_SNAPSHOT FRONT=0 BACK=0 DUST=0
EXPECT OK SET_SENSOR_SNAPSHOT

SEND GET_STATE
EXPECT_CONTAINS MOVEMENT=CLEANING
EXPECT_CONTAINS DIRECTION=BACKWARD
EXPECT_CONTAINS ROTATION_ACTIVE=0
EXPECT_CONTAINS FRONT=0
EXPECT_CONTAINS BACK=0
EXPECT_CONTAINS DRIVE=MOVE_BACKWARD
EXPECT_CONTAINS CLEANING_POWER=NORMAL
