SEND RESET
EXPECT OK RESET

SEND SET_FRONT 1
EXPECT OK SET_FRONT

SEND SET_LEFT 1
EXPECT OK SET_LEFT

SEND SET_FRONT 1
EXPECT OK SET_FRONT

SEND SET_BACK 0
EXPECT OK SET_BACK

SEND GET_STATE
EXPECT_CONTAINS MOVEMENT=BLOCKED
EXPECT_CONTAINS FRONT=1
EXPECT_CONTAINS BACK=0
EXPECT_CONTAINS LEFT=1
EXPECT_CONTAINS DRIVE=MOVE_BACKWARD
