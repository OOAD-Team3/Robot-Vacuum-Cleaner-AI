SEND SET_SENSOR_SNAPSHOT FRONT=1 BACK=0 DUST=1
EXPECT OK SET_SENSOR_SNAPSHOT

SEND GET_STATE
EXPECT_CONTAINS MOVEMENT=ROTATING
EXPECT_CONTAINS CLEANING_POWER=BOOST

SEND RESET
EXPECT OK RESET

SEND GET_STATE
EXPECT_CONTAINS MOVEMENT=STOPPED
EXPECT_CONTAINS DIRECTION=FORWARD
EXPECT_CONTAINS ROTATION_ACTIVE=0
EXPECT_CONTAINS FRONT=0
EXPECT_CONTAINS BACK=UNKNOWN
EXPECT_CONTAINS DUST=0
EXPECT_CONTAINS DRIVE=NONE
EXPECT_CONTAINS CLEANING_POWER=OFF
