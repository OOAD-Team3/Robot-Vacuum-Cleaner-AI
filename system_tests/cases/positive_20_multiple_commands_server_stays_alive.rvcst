SEND RESET
EXPECT OK RESET

SEND SET_SENSOR_SNAPSHOT FRONT=1 BACK=1 DUST=0
EXPECT OK SET_SENSOR_SNAPSHOT

SEND SET_SENSOR_SNAPSHOT FRONT=0 BACK=1 DUST=1
EXPECT OK SET_SENSOR_SNAPSHOT

SEND GET_STATE
EXPECT_CONTAINS MOVEMENT=ROTATING
EXPECT_CONTAINS DIRECTION=FORWARD
EXPECT_CONTAINS ROTATION_ACTIVE=1
EXPECT_CONTAINS FRONT=0
EXPECT_CONTAINS BACK=1
EXPECT_CONTAINS DUST=1
EXPECT_CONTAINS DRIVE=TURN_CLOCKWISE_90
EXPECT_CONTAINS CLEANING_POWER=BOOST
