SEND RESET
EXPECT OK RESET

SEND SET_FRONT 0
EXPECT OK SET_FRONT

SEND DUST_DETECTED
EXPECT OK DUST_DETECTED

SEND SET_FRONT 1
EXPECT OK SET_FRONT

SEND GET_STATE
EXPECT_CONTAINS MOVEMENT=AVOIDING_OBSTACLE
EXPECT_CONTAINS FRONT=1
EXPECT_CONTAINS DRIVE=STOP
EXPECT_CONTAINS CLEANING_POWER=INCREASED
EXPECT_CONTAINS TIMER_ACTIVE=1
